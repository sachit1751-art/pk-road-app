rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ? userDoc().role : 'resident';
    }

    function isAdmin() {
      return isSignedIn() && userExists() && userDoc().role == 'rwa_admin';
    }

    function isSecurityGuard() {
      return isSignedIn() && userExists() && userDoc().role == 'security_guard';
    }

    function isWorker() {
      return isSignedIn() && userExists() && userDoc().role in [
        'water_worker',
        'electrical_worker',
        'sanitation_worker',
        'maintenance_worker'
      ];
    }

    function getWorkerDept() {
      return userExists() ? userDoc().department : '';
    }

    function getUserFlat() {
      return userExists() ? userDoc().flatNumber : '';
    }

    function getUserBlock() {
      return userExists() ? userDoc().block : '';
    }

    // Health check
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSecurityGuard() ||
        isWorker()
      );

      // Create own profile as unverified resident only
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'resident' &&
        request.resource.data.verified == false &&
        request.resource.data.verificationStatus == 'unverified';

      // Update: admin can update anything; regular user can only update safe fields
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'department',
            'block',
            'flatNumber',
            'verified',
            'verificationStatus',
            'residentType'
          ]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'phone',
            'avatarUrl'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // Pre-approved visitors
    match /preapproved_visitors/{passId} {
      allow read: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        isSecurityGuard() ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.residentId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.residentId == request.auth.uid ||
        isAdmin()
      );
    }

    // Verification requests
    match /verification_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Issues
    match /issues/{issueId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.reporterId == request.auth.uid ||
        (isWorker() && (resource.data.department == getWorkerDept() || resource.data.assignedTo == request.auth.uid))
      );

      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isWorker() &&
          resource.data.department == getWorkerDept() &&
          (resource.data.assignedTo == request.auth.uid || request.resource.data.assignedTo == request.auth.uid)
        ) ||
        (
          resource.data.reporterId == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status',
            'assignedTo',
            'department',
            'resolutionProof'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // Visitors
    match /visitors/{visitorId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isSecurityGuard() ||
        (
          userExists() &&
          resource.data.flatNumber == getUserFlat() &&
          resource.data.block == getUserBlock()
        )
      );

      allow create: if isSecurityGuard() || isAdmin();

      allow update: if isSignedIn() && (
        isSecurityGuard() ||
        isAdmin() ||
        (
          userExists() &&
          resource.data.flatNumber == getUserFlat() &&
          resource.data.block == getUserBlock() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'residentApproval',
            'status'
          ]) &&
          request.resource.data.visitorName == resource.data.visitorName &&
          request.resource.data.phone == resource.data.phone &&
          request.resource.data.gate == resource.data.gate &&
          request.resource.data.block == resource.data.block &&
          request.resource.data.flatNumber == resource.data.flatNumber
        )
      );

      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'acknowledgedBy'
        ])
      );
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        isAdmin()
      );

      allow create: if isAdmin() || isSecurityGuard() || isWorker() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);

      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
