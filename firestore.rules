rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sachit1771@gmail.com' ||
        request.auth.token.email == 'admin@colony.local'
      );
    }

    // Health check document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Pre-approved frequent visitors
    match /preapproved_visitors/{visitorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Resident Verification Requests
    match /verification_requests/{requestId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Issues
    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Visitor Gate Entries
    match /visitors/{visitorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Official Announcements & Emergency Alerts
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Community Channel Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
